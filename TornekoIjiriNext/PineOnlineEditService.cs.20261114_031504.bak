using System.Buffers.Binary;

namespace TornekoIjiriNext;

/// <summary>
/// オンライン編集の共通入口。
/// アドレスの正当性を判定するものではないため、呼び出し側は
/// 検証済みアドレスとデータ形式だけを渡すこと。
/// </summary>
internal sealed class PineOnlineEditService
{
    private readonly Func<PineClient?> _getClient;
    private readonly Func<bool> _isSessionActive;
    private readonly object _gate = new();

    public PineOnlineEditService(
        Func<PineClient?> getClient,
        Func<bool> isSessionActive)
    {
        _getClient = getClient ?? throw new ArgumentNullException(nameof(getClient));
        _isSessionActive = isSessionActive ?? throw new ArgumentNullException(nameof(isSessionActive));
    }

    public bool TryRead(
        uint address,
        int length,
        out byte[] data,
        out string message)
    {
        lock (_gate)
        {
            data = [];
            message = "";

            try
            {
                var client = GetAuthorizedClient();
                ValidateRange(address, length);

                var result = client.ReadMemory(address, length);

                if (!ReferenceEquals(client, _getClient()) || !_isSessionActive())
                    throw new IOException("読み取り中に接続状態が変化しました。");

                data = result;
                message = "読み取り成功";
                return true;
            }
            catch (Exception ex)
            {
                message = ex.Message;
                return false;
            }
        }
    }

    public bool TryWriteBytes(
        uint address,
        byte[] newValue,
        out string message)
    {
        lock (_gate)
        {
            message = "";

            try
            {
                if (newValue is null || newValue.Length is < 1 or > 4096)
                    throw new ArgumentOutOfRangeException(
                        nameof(newValue),
                        "書き込みデータは1～4096バイトで指定してください。");

                ValidateRange(address, newValue.Length);

                var client = GetAuthorizedClient();
                var before = client.ReadMemory(address, newValue.Length);

                if (before.AsSpan().SequenceEqual(newValue))
                {
                    message = "変更なし";
                    return true;
                }

                var readBack = client.SafeWriteMemory(
                    address,
                    before,
                    newValue);

                if (!ReferenceEquals(client, _getClient()) || !_isSessionActive())
                    throw new IOException("書き込み後に接続状態が変化しました。");

                if (!readBack.AsSpan().SequenceEqual(newValue))
                    throw new IOException("読み戻し値が一致しません。");

                message = "書き込み・読み戻し確認成功";
                return true;
            }
            catch (Exception ex)
            {
                message = ex.Message;
                return false;
            }
        }
    }

    public bool TryWriteByte(
        uint address,
        byte value,
        out string message)
    {
        return TryWriteBytes(address, [value], out message);
    }

    public bool TryWriteWord(
        uint address,
        ushort value,
        out string message)
    {
        Span<byte> bytes = stackalloc byte[2];
        BinaryPrimitives.WriteUInt16LittleEndian(bytes, value);
        return TryWriteBytes(address, bytes.ToArray(), out message);
    }

    public bool TryWriteDword(
        uint address,
        uint value,
        out string message)
    {
        Span<byte> bytes = stackalloc byte[4];
        BinaryPrimitives.WriteUInt32LittleEndian(bytes, value);
        return TryWriteBytes(address, bytes.ToArray(), out message);
    }

    private PineClient GetAuthorizedClient()
    {
        if (!_isSessionActive())
            throw new IOException("オンライン編集にはPCSX2への接続と対象ゲームの起動が必要です。");

        var client = _getClient()
            ?? throw new IOException("PINEに接続されていません。");

        var status = client.GetStatus();
        if (status is not (0 or 1))
            throw new IOException("ゲームが動作していないため、オンライン編集を中止しました。");

        var game = client.GetGameInfo();
        if (!PineClient.IsAllowedGame(game))
            throw new IOException(
                "対象ゲームのID・CRC・バージョンが許可条件と一致しません。");

        if (!ReferenceEquals(client, _getClient()) || !_isSessionActive())
            throw new IOException("接続状態が変化しました。");

        return client;
    }

    private static void ValidateRange(uint address, int length)
    {
        if (length is < 1 or > 4096)
            throw new ArgumentOutOfRangeException(nameof(length));

        _ = checked(address + (uint)length - 1);
    }
}