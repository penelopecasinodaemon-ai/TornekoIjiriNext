+
+    private void Undo()
+    {
+        if (!CommitEdit()) return;
+        if (_undoStack.Count == 0)
+        {
+            _info.Text = "元に戻す操作はありません。";
+            return;
+        }
+
+        var action = _undoStack.Pop();
+        _redoStack.Push(action);
+        ApplyByteInternal(action.Offset, action.OldValue);
+
+        JumpToAbsoluteOffset(action.Offset);
+        LoadPage();
+        _info.Text = $"Undo: offset 0x{action.Offset:X8} = {action.OldValue:X2}";
+    }
+
+    private void Redo()
+    {
+        if (!CommitEdit()) return;
+        if (_redoStack.Count == 0)
+        {
+            _info.Text = "やり直す操作はありません。";
+            return;
+        }
+
+        var action = _redoStack.Pop();
+        _undoStack.Push(action);
+        ApplyByteInternal(action.Offset, action.NewValue);
+
+        JumpToAbsoluteOffset(action.Offset);
+        LoadPage();
+        _info.Text = $"Redo: offset 0x{action.Offset:X8} = {action.NewValue:X2}";
+    }
+
+    private void ApplyByteInternal(int offset, byte newValue)
+    {
+        if (!_savedValues.ContainsKey(offset))
+        {
+            byte originalRef = _lastSavedBytes.TryGetValue(offset, out var savedVal) ? savedVal : _data[offset];
+            _savedValues[offset] = originalRef;
+        }
+
+        _data[offset] = newValue;
+
+        if (_savedValues.TryGetValue(offset, out var orig) && orig == newValue)
+        {
+            _savedValues.Remove(offset);
+        }
+
+        UpdateDiffState();
+    }
