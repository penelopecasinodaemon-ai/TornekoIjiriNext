+    private void SearchHexBytes()
+    {
+        if (!CommitEdit()) return;
+        var cleaned = _searchInput.Text.Trim().Replace(" ", "").Replace("-", "");
+        if (cleaned.Length == 0 || cleaned.Length % 2 != 0)
+        {
+            MessageBox.Show(this, "HEXバイト列は偶数桁の16進数で入力してください（例: 01 FF A0）。", Text, MessageBoxButtons.OK, MessageBoxIcon.Warning);
+            return;
+        }
+
+        byte[] pattern;
+        try
+        {
+            pattern = Convert.FromHexString(cleaned);
+        }
+        catch
+        {
+            MessageBox.Show(this, "16進数以外の文字が含まれています。", Text, MessageBoxButtons.OK, MessageBoxIcon.Warning);
+            return;
+        }
+
+        int start = _lastSearchIndex + 1;
+        if (start < 0 || start >= _data.Length) start = 0;
+
+        int found = FindPattern(pattern, start);
+        if (found == -1 && start > 0)
+            found = FindPattern(pattern, 0);
+
+        if (found != -1)
+        {
+            _lastSearchIndex = found;
+            JumpToAbsoluteOffset(found);
+            _info.Text = $"一致箇所へ移動: offset 0x{found:X8}";
+        }
+        else
+        {
+            MessageBox.Show(this, "指定されたバイト列は見つかりませんでした。", Text, MessageBoxButtons.OK, MessageBoxIcon.Information);
+        }
+    }
+
+    private int FindPattern(byte[] pattern, int startIndex)
+    {
+        var span = _data.AsSpan();
+        int index = span[startIndex..].IndexOf(pattern);
+        return index >= 0 ? startIndex + index : -1;
+    }
