+    private void JumpToOffset()
+    {
+        if (!CommitEdit()) return;
+        var text = _offsetInput.Text.Trim();
+        if (string.IsNullOrEmpty(text)) return;
+
+        try
+        {
+            int offset;
+            if (_rbHexOffset.Checked)
+            {
+                if (text.StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+                    text = text[2..];
+                offset = int.Parse(text, NumberStyles.HexNumber, CultureInfo.InvariantCulture);
+            }
+            else
+            {
+                offset = int.Parse(text, NumberStyles.Integer, CultureInfo.InvariantCulture);
+            }
+
+            if (offset < 0 || offset >= _data.Length)
+            {
+                MessageBox.Show(this, $"オフセットが範囲外です (0 〜 0x{_data.Length - 1:X})。", Text, MessageBoxButtons.OK, MessageBoxIcon.Warning);
+                return;
+            }
+
+            JumpToAbsoluteOffset(offset);
+            _info.Text = $"ジャンプ完了: offset 0x{offset:X8} ({offset})";
+        }
+        catch
+        {
+            MessageBox.Show(this, "オフセットの入力形式が不正です。", Text, MessageBoxButtons.OK, MessageBoxIcon.Warning);
+        }
+    }
+
+    private void JumpToAbsoluteOffset(int offset)
+    {
+        int targetPage = offset / BytesPerPage;
+        if (targetPage != decimal.ToInt32(_page.Value))
+        {
+            _page.Value = targetPage;
+        }
+
+        int rowIndex = (offset % BytesPerPage) / BytesPerRow;
+        int colIndex = (offset % BytesPerRow) + 1;
+        if (rowIndex < _grid.Rows.Count && colIndex < _grid.Columns.Count)
+        {
+            _grid.ClearSelection();
+            _grid.Rows[rowIndex].Cells[colIndex].Selected = true;
+            _grid.CurrentCell = _grid.Rows[rowIndex].Cells[colIndex];
+        }
+    }
