+    private static void SaveSafelyWithBackup(string targetPath, byte[] data)
+    {
+        string dir = Path.GetDirectoryName(targetPath) ?? Environment.CurrentDirectory;
+        string tempPath = Path.Combine(dir, $".{Path.GetFileName(targetPath)}.{Guid.NewGuid():N}.tmp");
+        string backupPath = $"{targetPath}.{DateTime.Now:yyyyMMdd_HHmmss_fff}_{Guid.NewGuid():N}.bak";
+
+        try
+        {
+            // 1. 一時ファイルに書き込み
+            using (var fs = new FileStream(tempPath, FileMode.CreateNew, FileAccess.Write, FileShare.None))
+            {
+                fs.Write(data, 0, data.Length);
+                fs.Flush(true);
+            }
+
+            // 2. 既存ファイルがある場合はバックアップ作成を伴う File.Replace、ない場合は File.Move を実行
+            if (File.Exists(targetPath))
+            {
+                File.Replace(tempPath, targetPath, backupPath, ignoreMetadataErrors: true);
+            }
+            else
+            {
+                File.Move(tempPath, targetPath);
+            }
+        }
+        catch
+        {
+            // File.Replace 実行前の失敗であれば元ファイルへの置き換えは行われない。
+            // 残存している一時ファイルは可能な限り削除する。
+            if (File.Exists(tempPath))
+            {
+                try { File.Delete(tempPath); } catch { }
+            }
+            throw;
+        }
+    }
