using System.Globalization;

namespace TornekoIjiriNext;

/// <summary>
/// Generic offline binary editor for legacy/unknown assets. It never connects to PINE.
/// Editing is page-based so large assets remain usable while untouched bytes are preserved.
/// </summary>
internal sealed class LegacyBinaryEditorForm : Form
{
    private const int BytesPerPage = 4096;
    private const int BytesPerRow = 16;
    private const int MaximumAssetLength = 64 * 1024 * 1024;

    private readonly DataGridView _grid = new()
    {
        Dock = DockStyle.Fill,
        AllowUserToAddRows = false,
        AllowUserToDeleteRows = false,
        RowHeadersWidth = 105,
        AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill,
        ColumnHeadersHeightSizeMode = DataGridViewColumnHeadersHeightSizeMode.AutoSize,
        MultiSelect = false,
        SelectionMode = DataGridViewSelectionMode.CellSelect,
        ClipboardCopyMode = DataGridViewClipboardCopyMode.EnableWithoutHeaderText
    };
    private readonly NumericUpDown _page = new() { Minimum = 0, Maximum = 0, Width = 110, ThousandsSeparator = true };
    private readonly Label _info = new() { AutoSize = true, Padding = new Padding(8, 7, 4, 0) };
    private readonly byte[] _data;
    private readonly string? _sourcePath;
    private readonly Func<byte[], string>? _saveToBundle;
    private readonly string _assetName;
    private bool _loading;
    private bool _dirty;

    public LegacyBinaryEditorForm(string path, Func<byte[], string>? saveToBundle = null)
    {
        _sourcePath = Path.GetFullPath(path);
        _assetName = Path.GetFileName(path);
        _saveToBundle = saveToBundle;
        var info = new FileInfo(path);
        if (!info.Exists || info.Length > MaximumAssetLength)
            throw new InvalidDataException("ファイルが存在しないか、64 MiBを超えています。");
        _data = File.ReadAllBytes(path);
        InitializeUi();
    }

    public LegacyBinaryEditorForm(byte[] bytes, string displayName = "未保存データ")
    {
        if (bytes.Length > MaximumAssetLength) throw new InvalidDataException("データは64 MiB以下にしてください。");
        _data = bytes.ToArray();
        _assetName = displayName;
        InitializeUi();
    }

    private void InitializeUi()
    {
        Text = $"汎用バイナリ編集（オフライン） - {_assetName}";
        Width = 1050;
        Height = 720;
        MinimumSize = new Size(760, 500);
        StartPosition = FormStartPosition.CenterParent;

        _grid.Columns.Add(new DataGridViewTextBoxColumn
        {
            Name = "Offset",
            HeaderText = "Offset",
            ReadOnly = true,
            FillWeight = 145,
            SortMode = DataGridViewColumnSortMode.NotSortable
        });
        for (var column = 0; column < BytesPerRow; column++)
            _grid.Columns.Add(new DataGridViewTextBoxColumn
            {
                Name = $"B{column:X1}",
                HeaderText = column.ToString("X2"),
                FillWeight = 50,
                MaxInputLength = 2,
                SortMode = DataGridViewColumnSortMode.NotSortable
            });
        _grid.CellValidating += ValidateCell;
        _grid.CellValueChanged += CellChanged;
        _grid.DataError += (_, e) => { e.ThrowException = false; _info.Text = "入力値が不正です。00〜FFの16進数2桁で入力してください。"; };

        var previous = new Button { Text = "前のページ", AutoSize = true };
        var next = new Button { Text = "次のページ", AutoSize = true };
        var save = new Button { Text = _saveToBundle is null ? "名前を付けて保存…" : "編集版をプロジェクトへ保存", AutoSize = true };
        previous.Click += (_, _) => { if (CommitEdit() && _page.Value > 0) _page.Value--; };
        next.Click += (_, _) => { if (CommitEdit() && _page.Value < _page.Maximum) _page.Value++; };
        _page.ValueChanged += (_, _) => LoadPage();
        save.Click += (_, _) => Save();
        var top = new FlowLayoutPanel { Dock = DockStyle.Fill, AutoSize = true, WrapContents = true };
        top.Controls.Add(previous);
        top.Controls.Add(new Label { Text = "ページ (1 page = 4096 bytes)", AutoSize = true, Padding = new Padding(6, 7, 0, 0) });
        top.Controls.Add(_page);
        top.Controls.Add(next);
        top.Controls.Add(save);
        top.Controls.Add(_info);
        var note = new Label
        {
            Dock = DockStyle.Fill,
            AutoSize = true,
            MaximumSize = new Size(1000, 0),
            ForeColor = Color.DarkSlateBlue,
            Text = "ローカルファイルだけを編集します。未編集ページ・未変更byteは保持されます。ここでの値は意味未判定のraw dataであり、ゲームへの書き込みは行いません。"
        };
        var root = new TableLayoutPanel { Dock = DockStyle.Fill, Padding = new Padding(10), ColumnCount = 1, RowCount = 3 };
        root.RowStyles.Add(new RowStyle(SizeType.AutoSize));
        root.RowStyles.Add(new RowStyle(SizeType.Percent, 100));
        root.RowStyles.Add(new RowStyle(SizeType.AutoSize));
        root.Controls.Add(top, 0, 0);
        root.Controls.Add(_grid, 0, 1);
        root.Controls.Add(note, 0, 2);
        Controls.Add(root);

        _page.Maximum = Math.Max(0, (_data.Length - 1) / BytesPerPage);
        LoadPage();
    }

    private void LoadPage()
    {
        _loading = true;
        try
        {
            _grid.Rows.Clear();
            var start = decimal.ToInt32(_page.Value) * BytesPerPage;
            var end = Math.Min(_data.Length, start + BytesPerPage);
            for (var offset = start; offset < end; offset += BytesPerRow)
            {
                var row = new object[BytesPerRow + 1];
                row[0] = $"0x{offset:X8}";
                for (var column = 0; column < BytesPerRow; column++)
                    row[column + 1] = offset + column < end ? _data[offset + column].ToString("X2") : "";
                _grid.Rows.Add(row);
            }
            _info.Text = $"サイズ: {_data.Length:N0} bytes / 表示: 0x{start:X8}〜0x{Math.Max(start, end - 1):X8}" + (_dirty ? " / 未保存の変更あり" : "");
        }
        finally { _loading = false; }
    }

    private void ValidateCell(object? sender, DataGridViewCellValidatingEventArgs e)
    {
        if (e.RowIndex < 0 || e.ColumnIndex == 0) return;
        var value = Convert.ToString(e.FormattedValue)?.Trim() ?? "";
        var absoluteOffset = GetAbsoluteOffset(e.RowIndex, e.ColumnIndex - 1);
        if (absoluteOffset >= _data.Length && value.Length == 0) return;
        if (value.Length != 2 || !byte.TryParse(value, NumberStyles.HexNumber, CultureInfo.InvariantCulture, out _))
        {
            e.Cancel = true;
            _info.Text = "入力値が不正です。00〜FFの16進数2桁で入力してください。";
        }
    }

    private void CellChanged(object? sender, DataGridViewCellEventArgs e)
    {
        if (_loading || e.RowIndex < 0 || e.ColumnIndex <= 0) return;
        var offset = GetAbsoluteOffset(e.RowIndex, e.ColumnIndex - 1);
        if (offset >= _data.Length) return;
        var text = Convert.ToString(_grid.Rows[e.RowIndex].Cells[e.ColumnIndex].Value)?.Trim() ?? "";
        if (!byte.TryParse(text, NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var value)) return;
        if (_data[offset] == value) return;
        _data[offset] = value;
        _dirty = true;
        _info.Text = $"変更あり: offset 0x{offset:X8} = {value:X2} / {_data.Length:N0} bytes";
    }

    private int GetAbsoluteOffset(int row, int byteColumn) =>
        decimal.ToInt32(_page.Value) * BytesPerPage + row * BytesPerRow + byteColumn;

    private bool CommitEdit()
    {
        if (_grid.IsCurrentCellInEditMode && !_grid.EndEdit()) return false;
        return Validate();
    }

    private void Save()
    {
        try
        {
            if (!CommitEdit()) return;
            if (_saveToBundle is not null)
            {
                var savedName = _saveToBundle(_data);
                _dirty = false;
                _info.Text = $"プロジェクトへ保存しました: {savedName}";
                return;
            }
            using var dialog = new SaveFileDialog
            {
                Filter = "Binary (*.bin)|*.bin|すべてのファイル (*.*)|*.*",
                FileName = Path.GetFileNameWithoutExtension(_assetName) + "_edited" + Path.GetExtension(_assetName),
                AddExtension = true
            };
            if (dialog.ShowDialog(this) != DialogResult.OK) return;
            File.WriteAllBytes(dialog.FileName, _data);
            _dirty = false;
            _info.Text = $"保存しました: {dialog.FileName}";
        }
        catch (Exception ex)
        {
            MessageBox.Show(this, ex.Message, "保存失敗", MessageBoxButtons.OK, MessageBoxIcon.Error);
        }
    }

    protected override void OnFormClosing(FormClosingEventArgs e)
    {
        if (!CommitEdit())
        {
            e.Cancel = true;
            return;
        }
        if (_dirty && MessageBox.Show(this, "未保存の編集があります。閉じてもよろしいですか？", Text,
            MessageBoxButtons.YesNo, MessageBoxIcon.Warning) != DialogResult.Yes)
        {
            e.Cancel = true;
            return;
        }
        base.OnFormClosing(e);
    }
}
